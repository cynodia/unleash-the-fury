#!/usr/bin/env bash
set -uo pipefail

#
# Kingston Fury DDR5 RGB off
#
# Auto-detects the I2C/SMBus and DIMM addresses.
#
# Expected address relationship:
#
#   SPD 0x50 -> RGB 0x60
#   SPD 0x51 -> RGB 0x61
#   ...
#   SPD 0x57 -> RGB 0x67
#

if ! command -v i2cdetect >/dev/null 2>&1 ||
   ! command -v i2cset >/dev/null 2>&1; then
    echo "ERROR: i2c-tools is required." >&2
    exit 1
fi


# ------------------------------------------------------------
# Check whether an address appears in an i2cdetect scan.
# ------------------------------------------------------------

address_exists() {
    local scan="$1"
    local addr="$2"
    local hex

    printf -v hex '%02x' "$addr"

    echo "$scan" |
        awk '{
            for (i = 2; i <= NF; i++)
                print $i
        }' |
        grep -qx "$hex"
}


# ------------------------------------------------------------
# Find all available I2C buses.
# ------------------------------------------------------------

mapfile -t BUSES < <(
    i2cdetect -l |
        awk '{
            bus=$1
            sub(/^i2c-/, "", bus)

            if (bus ~ /^[0-9]+$/)
                print bus
        }'
)

if [[ ${#BUSES[@]} -eq 0 ]]; then
    echo "ERROR: No I2C buses found." >&2
    exit 1
fi

echo "Found I2C buses: ${BUSES[*]}"
echo


# ------------------------------------------------------------
# Search all buses for matching SPD + RGB addresses.
# ------------------------------------------------------------

FOUND_BUS=""
RGB_ADDRESSES=()

for BUS in "${BUSES[@]}"; do

    echo "Scanning i2c-$BUS..."

    # Some buses (GPU, AUX etc.) may not support probing.
    if ! SCAN="$(i2cdetect -y "$BUS" 2>/dev/null)"; then
        echo "  Cannot scan i2c-$BUS, skipping."
        continue
    fi

    BUS_RGB_ADDRESSES=()

    for ((SPD_DEC = 0x50; SPD_DEC <= 0x57; SPD_DEC++)); do

        RGB_DEC=$((SPD_DEC + 0x10))

        if address_exists "$SCAN" "$SPD_DEC" &&
           address_exists "$SCAN" "$RGB_DEC"; then

            printf -v SPD_HEX '0x%02x' "$SPD_DEC"
            printf -v RGB_HEX '0x%02x' "$RGB_DEC"

            echo "  Found DIMM candidate: SPD $SPD_HEX -> RGB $RGB_HEX"

            BUS_RGB_ADDRESSES+=("$RGB_HEX")
        fi
    done

    if [[ ${#BUS_RGB_ADDRESSES[@]} -gt 0 ]]; then

        if [[ -n "$FOUND_BUS" ]]; then
            echo
            echo "ERROR: Fury-like DIMMs found on multiple I2C buses." >&2
            echo "Refusing to guess which bus to use." >&2
            exit 1
        fi

        FOUND_BUS="$BUS"
        RGB_ADDRESSES=("${BUS_RGB_ADDRESSES[@]}")
    fi

done


# ------------------------------------------------------------
# Validate result.
# ------------------------------------------------------------

if [[ -z "$FOUND_BUS" ]]; then
    echo
    echo "ERROR: No Kingston Fury RGB DIMMs found." >&2
    exit 1
fi

BUS="$FOUND_BUS"

echo
echo "Using i2c-$BUS"
echo "Found ${#RGB_ADDRESSES[@]} RGB DIMM(s): ${RGB_ADDRESSES[*]}"
echo


# ------------------------------------------------------------
# Kingston Fury RGB command sequence.
# ------------------------------------------------------------

RGB_SEQUENCE=(
    "0x08 0x53" # Enter configuration mode
    "0x09 0x00" # Static mode

    "0x31 0x00" # Red
    "0x32 0x00" # Green
    "0x33 0x00" # Blue

    "0x20 0x64" # Minimum brightness / LEDs off

    "0x08 0x44" # Apply / leave configuration mode
)


# ------------------------------------------------------------
# Disable RGB.
# ------------------------------------------------------------

FAILURES=0

for ADDR in "${RGB_ADDRESSES[@]}"; do

    echo "Turning off RGB at $ADDR..."

    DIMM_FAILED=0

    for WRITE in "${RGB_SEQUENCE[@]}"; do

        REGISTER="${WRITE%% *}"
        VALUE="${WRITE##* }"

        if ! i2cset -y "$BUS" "$ADDR" "$REGISTER" "$VALUE"; then

            echo \
                "ERROR: Write failed: $ADDR $REGISTER $VALUE" \
                >&2

            DIMM_FAILED=1
            FAILURES=$((FAILURES + 1))
            break
        fi

        sleep 0.02
    done

    if [[ "$DIMM_FAILED" -eq 0 ]]; then
        echo "  Done."
    fi

done


# ------------------------------------------------------------
# Result
# ------------------------------------------------------------

echo

if [[ "$FAILURES" -gt 0 ]]; then
    echo "Completed with $FAILURES failure(s)." >&2
    exit 1
fi

echo "Kingston Fury RGB disabled."
