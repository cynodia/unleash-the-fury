#!/usr/bin/env bash
set -uo pipefail

#
# Kingston Fury DDR5 RGB off
#
# Automatically detects the system SMBus and Kingston Fury DIMMs.
#
# Kingston Fury DDR5 address relationship:
#
#   SPD 0x50 -> RGB 0x60
#   SPD 0x51 -> RGB 0x61
#   ...
#   SPD 0x57 -> RGB 0x67
#
# Requires: i2c-tools
#

# ------------------------------------------------------------
# Requirements
# ------------------------------------------------------------

for CMD in i2cdetect i2cset; do
    if ! command -v "$CMD" >/dev/null 2>&1; then
        echo "ERROR: $CMD not found. Install i2c-tools." >&2
        exit 1
    fi
done


# ------------------------------------------------------------
# Must run as root
# ------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: This script must be run as root." >&2
    exit 1
fi


# ------------------------------------------------------------
# Check whether an address occurs in an i2cdetect scan
# ------------------------------------------------------------

address_exists() {
    local scan="$1"
    local addr="$2"
    local hex

    printf -v hex '%02x' "$addr"

    echo "$scan" |
        awk '{
            for (i = 2; i <= NF; i++)
                print $i
        }' |
        grep -qx "$hex"
}


# ------------------------------------------------------------
# Find SMBus adapters only
#
# Example:
#
# i2c-3  smbus  SMBus I801 adapter at 0000:00:1f.4
#
# This deliberately ignores ordinary I2C adapters such as
# GPU DDC, DisplayPort AUX and DesignWare buses.
# ------------------------------------------------------------

mapfile -t SMBUS_BUSES < <(
    i2cdetect -l |
        awk '$2 == "smbus" {
            bus=$1
            sub(/^i2c-/, "", bus)

            if (bus ~ /^[0-9]+$/)
                print bus
        }'
)

if [[ ${#SMBUS_BUSES[@]} -eq 0 ]]; then
    echo "ERROR: No SMBus adapters found." >&2
    exit 1
fi

echo "Found SMBus adapter(s):"

for BUS in "${SMBUS_BUSES[@]}"; do
    DESCRIPTION="$(
        i2cdetect -l |
        awk -v target="i2c-$BUS" '$1 == target {
            $1=""
            $2=""
            sub(/^[ \t]+/, "")
            print
        }'
    )"

    echo "  i2c-$BUS: $DESCRIPTION"
done

echo


# ------------------------------------------------------------
# Search SMBus adapters for Fury DIMMs
# ------------------------------------------------------------

FOUND_BUS=""
RGB_ADDRESSES=()

for BUS in "${SMBUS_BUSES[@]}"; do

    echo "Scanning i2c-$BUS..."

    if ! SCAN="$(i2cdetect -y "$BUS" 2>/dev/null)"; then
        echo "  Unable to scan i2c-$BUS; skipping."
        continue
    fi

    BUS_RGB_ADDRESSES=()

    for ((SPD_DEC = 0x50; SPD_DEC <= 0x57; SPD_DEC++)); do

        RGB_DEC=$((SPD_DEC + 0x10))

        if address_exists "$SCAN" "$SPD_DEC" &&
           address_exists "$SCAN" "$RGB_DEC"; then

            printf -v SPD_HEX '0x%02x' "$SPD_DEC"
            printf -v RGB_HEX '0x%02x' "$RGB_DEC"

            echo "  Found DIMM candidate: SPD $SPD_HEX -> RGB $RGB_HEX"

            BUS_RGB_ADDRESSES+=("$RGB_HEX")
        fi
    done

    if [[ ${#BUS_RGB_ADDRESSES[@]} -gt 0 ]]; then

        if [[ -n "$FOUND_BUS" ]]; then
            echo
            echo "ERROR: Fury-like DIMMs found on multiple SMBus adapters." >&2
            echo "Refusing to choose a bus automatically." >&2
            exit 1
        fi

        FOUND_BUS="$BUS"
        RGB_ADDRESSES=("${BUS_RGB_ADDRESSES[@]}")
    fi

done


# ------------------------------------------------------------
# Validate detection
# ------------------------------------------------------------

if [[ -z "$FOUND_BUS" ]]; then
    echo
    echo "ERROR: No Kingston Fury RGB DIMMs found." >&2
    exit 1
fi

BUS="$FOUND_BUS"

echo
echo "Using i2c-$BUS"
echo "Found ${#RGB_ADDRESSES[@]} RGB DIMM(s): ${RGB_ADDRESSES[*]}"
echo


# ------------------------------------------------------------
# Kingston Fury RGB command sequence
# ------------------------------------------------------------

RGB_SEQUENCE=(
    "0x08 0x53" # Enter configuration mode
    "0x09 0x00" # Static mode

    "0x31 0x00" # Red
    "0x32 0x00" # Green
    "0x33 0x00" # Blue

    "0x20 0x64" # Minimum brightness / LEDs off

    "0x08 0x44" # Apply / leave configuration mode
)


# ------------------------------------------------------------
# Disable RGB
# ------------------------------------------------------------

FAILURES=0

for ADDR in "${RGB_ADDRESSES[@]}"; do

    echo "Turning off RGB at $ADDR..."

    DIMM_FAILED=0

    for WRITE in "${RGB_SEQUENCE[@]}"; do

        REGISTER="${WRITE%% *}"
        VALUE="${WRITE##* }"

        if ! i2cset -y "$BUS" "$ADDR" "$REGISTER" "$VALUE"; then

            echo "ERROR: Write failed: $ADDR $REGISTER $VALUE" >&2

            DIMM_FAILED=1
            FAILURES=$((FAILURES + 1))
            break
        fi

        sleep 0.02
    done

    if [[ "$DIMM_FAILED" -eq 0 ]]; then
        echo "  Done."
    fi

done


# ------------------------------------------------------------
# Result
# ------------------------------------------------------------

echo

if [[ "$FAILURES" -gt 0 ]]; then
    echo "Completed with $FAILURES failure(s)." >&2
    exit 1
fi

echo "Kingston Fury RGB disabled."
