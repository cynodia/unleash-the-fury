#!/usr/bin/env bash
set -uo pipefail

BUS="${BUS:-}"

if ! command -v i2cdetect >/dev/null 2>&1 || ! command -v i2cset >/dev/null 2>&1; then
    echo "ERROR: i2c-tools is required." >&2
    exit 1
fi

#
# Auto-detect Intel I801 SMBus
#
if [[ -z "$BUS" ]]; then
    mapfile -t MATCHING_BUSES < <(
        i2cdetect -l |
        awk '/SMBus I801/ {
            sub(/^i2c-/, "", $1)
            print $1
        }'
    )

    if [[ ${#MATCHING_BUSES[@]} -eq 1 ]]; then
        BUS="${MATCHING_BUSES[0]}"
    elif [[ ${#MATCHING_BUSES[@]} -gt 1 ]]; then
        echo "ERROR: Found multiple SMBus I801 adapters." >&2
        exit 1
    fi
fi

if [[ -z "$BUS" ]]; then
    echo "ERROR: Could not find SMBus I801 adapter." >&2
    i2cdetect -l
    exit 1
fi

echo "Using i2c-$BUS"
echo "Scanning i2c-$BUS..."

SCAN="$(i2cdetect -y "$BUS")"

address_exists() {
    local addr="$1"
    local hex

    printf -v hex '%02x' "$addr"

    echo "$SCAN" |
        awk '{
            for (i = 2; i <= NF; i++)
                print $i
        }' |
        grep -qx "$hex"
}

RGB_ADDRESSES=()

#
# Kingston Fury DDR5:
# SPD 0x50..0x57
# RGB controller = SPD + 0x10
#
for ((SPD_DEC = 0x50; SPD_DEC <= 0x57; SPD_DEC++)); do
    RGB_DEC=$((SPD_DEC + 0x10))

    if address_exists "$SPD_DEC" && address_exists "$RGB_DEC"; then
        printf -v SPD_HEX '0x%02x' "$SPD_DEC"
        printf -v RGB_HEX '0x%02x' "$RGB_DEC"

        echo "Found DIMM: SPD $SPD_HEX -> RGB $RGB_HEX"
        RGB_ADDRESSES+=("$RGB_HEX")
    fi
done

if [[ ${#RGB_ADDRESSES[@]} -eq 0 ]]; then
    echo "ERROR: No Kingston Fury RGB DIMMs found." >&2
    echo
    echo "$SCAN"
    exit 1
fi

echo "Found ${#RGB_ADDRESSES[@]} RGB DIMM(s): ${RGB_ADDRESSES[*]}"

RGB_SEQUENCE=(
    "0x08 0x53"
    "0x09 0x00"
    "0x31 0x00"
    "0x32 0x00"
    "0x33 0x00"
    "0x20 0x64"
    "0x08 0x44"
)

for ADDR in "${RGB_ADDRESSES[@]}"; do
    echo "Turning off RGB at $ADDR"

    for WRITE in "${RGB_SEQUENCE[@]}"; do
        REGISTER="${WRITE%% *}"
        VALUE="${WRITE##* }"

        if ! i2cset -y "$BUS" "$ADDR" "$REGISTER" "$VALUE"; then
            echo "ERROR: Write failed at $ADDR register $REGISTER" >&2
            break
        fi

        sleep 0.02
    done
done

echo "Kingston Fury RGB configuration complete."
